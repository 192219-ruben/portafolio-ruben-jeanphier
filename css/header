.header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 15px 30px;
    background-color: #1e1e1e;
    color: white;
}

.nav a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
}

.menu-toggle {
    display: none;
}

@media (max-width: 768px) {
    .menu-toggle {
        display: block;
        background: none;
        border: none;
        color: white;
        font-size: 24px;
    }

    .nav {
        display: none;
        flex-direction: column;
    }

    .nav.active {
        display: flex;
    }
}
