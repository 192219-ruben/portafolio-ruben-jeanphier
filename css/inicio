/* ===== SECCIÓN INICIO ===== */
.inicio {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 60px 30px;
    min-height: 90vh;
    background-color: #f9f9f9;
}

/* ===== TEXTO ===== */
.inicio-texto {
    max-width: 600px;
}

.inicio-texto h1 {
    font-size: 36px;
    margin-bottom: 10px;
    line-height: 1.2;
}

.inicio-texto h2 {
    font-size: 22px;
    color: #555;
    margin-bottom: 20px;
    font-weight: 400;
}

.inicio-texto p {
    font-size: 16px;
    color: #666;
    margin-bottom: 25px;
    line-height: 1.6;
}

/* ===== BOTONES ===== */
.botones {
    display: flex;
    gap: 15px;
}

.botones .btn {
    display: inline-block;
    padding: 10px 22px;
    text-decoration: none;
    background-color: #1e1e1e;
    color: #fff;
    border-radius: 5px;
    font-weight: 600;
    transition: background-color 0.3s ease;
}

.botones .btn:hover {
    background-color: #000;
}

.btn-secundario {
    background-color: #555;
}

.btn-secundario:hover {
    background-color: #333;
}

/* ===== IMAGEN ===== */
.inicio-imagen img {
    width: 250px;
    border-radius: 50%;
    object-fit: cover;
}

/* ===== RESPONSIVE ===== */
@media (max-width: 768px) {
    .inicio {
        flex-direction: column;
        text-align: center;
        padding: 40px 20px;
    }

    .inicio-imagen {
        margin-top: 30px;
    }

    .botones {
        justify-content: center;
    }
}
